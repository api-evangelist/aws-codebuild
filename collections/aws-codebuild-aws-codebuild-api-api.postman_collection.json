  "info": {
    "_postman_id": "375a7eb3-205f-4abd-b084-e2310f08820e",
    "name": "AWS CodeBuild AWS CodeBuild API API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "AWS CodeBuild is a fully managed continuous integration build service.\nThe CodeBuild API uses an AWS JSON 1.1 RPC protocol: all operations are\nPOST requests to the root path with the operation name specified in the\nX-Amz-Target header (e.g. `CodeBuild_20161006.StartBuild`). All requests\nare signed with AWS Signature Version 4 (SigV4).\n\nSee https://docs.aws.amazon.com/codebuild/latest/APIReference/Welcome.html\n",
      "type": "text/plain"
    }
  }
